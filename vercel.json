{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.go",
      "use": "@vercel/go"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/posts/(.*)",
      "destination": "/api/post/slug.go"
    },
    {
      "source": "/api/posts",
      "destination": "/api/posts.go"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
